# Clés API / secrets externes
OPEN_ROUTER_API=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Connexion base de données
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragproject
VECTOR_DIMENSION=1536

# Paramètres du pipeline
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_PROVIDER=open-router
EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_PROVIDER=google
LLM_MODEL=google/gemini-3.8-flash
TOP_K=5

# Paramètres d'environnement
ENVIRONMENT=dev
LOG_LEVEL=INFO
